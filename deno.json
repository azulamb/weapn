{
  "name": "@azulamb/weapn",
  "version": "0.4.1",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./app": "./app.mod.ts",
    "./build": "./build.mod.ts",
    "./ui-worker": "./ui-worker.mod.ts",
    "./worker": "./src/ui_worker_entry.ts",
    "./client": "./client.mod.ts",
    "./types": "./types.ts"
  },
  "tasks": {
    "test:worker": "deno test --allow-read --allow-write --allow-net tests/worker_app_test.ts tests/protocol_test.ts",
    "test:build": "deno test --allow-run --allow-read --allow-write --allow-net --allow-env tests/build_test.ts",
    "check:docs": "deno doc --lint mod.ts app.mod.ts build.mod.ts client.mod.ts ui-worker.mod.ts src/ui_worker_entry.ts types.ts",
    "check:publish": "deno lint && deno task check:docs && deno task test:worker && deno publish --dry-run --allow-dirty",
    "check": "deno task check:publish",
    "test:native": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net tests/ui_smoke_test.ts tests/transparency_test.ts",
    "check:samples": "deno run --allow-read --allow-write --allow-run --allow-net tools/check_samples.ts"
  },
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@azulamb/webview2", "jsr:@azulamb/winapi"]
  },
  "lint": {
    "include": [
      "./sample*",
      "./src",
      "deno.json",
      "./*mod.ts",
      "types.ts",
      "./tests",
      "./tools"
    ]
  },
  "fmt": {
    "include": [
      "./sample*/**",
      "./src",
      "deno.json",
      "./*mod.ts",
      "types.ts",
      "./tests",
      "./tools"
    ],
    "singleQuote": true
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8",
    "@azulamb/webview2": "jsr:@azulamb/webview2@^0.7.1",
    "@azulamb/winapi": "jsr:@azulamb/winapi@^0.4.0",
    "@azulamb/weapn": "./mod.ts"
  }
}
